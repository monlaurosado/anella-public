{
  "name": "anella",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/dependency-security.mjs verify && prisma generate && tsx scripts/deploy-schema-before-build.ts && RAYON_NUM_THREADS=1 next build --webpack",
    "start": "next start",
    "start:e2e": "next start --hostname 127.0.0.1 --port 3100",
    "test:production-start": "dotenv -e .env.test -- tsx scripts/smoke-production-start.ts",
    "lint": "eslint src tests scripts prisma/*.ts *.config.ts --cache --cache-location .cache/eslint",
    "typecheck": "tsc --noEmit",
    "test": "dotenv -e .env.test -- npm run test:run",
    "test:run": "npm run db:deploy && npm run db:seed && vitest run",
    "test:load": "dotenv -e .env.test -- npm run test:load:run",
    "test:load:run": "npm run db:deploy && RUN_QUEUE_LOAD=true vitest run tests/integration/queue-load.test.ts --reporter=verbose",
    "test:watch": "dotenv -e .env.test -- vitest",
    "test:e2e": "dotenv -e .env.test -- npm run test:e2e:run",
    "test:e2e:run": "npm run db:deploy && npm run db:seed && npm run build && playwright test",
    "postinstall": "node scripts/dependency-security.mjs apply && prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:preflight": "tsx scripts/preflight-migrations.ts",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:prepare-demo": "SEED_DEMO_DATA=true npm run db:deploy && SEED_DEMO_DATA=true npm run db:seed",
    "db:maintenance": "tsx scripts/purge-expired-data.ts",
    "db:purge-expired": "npm run db:maintenance",
    "db:restore-drill": "tsx scripts/backup-restore-drill.ts",
    "catalog:municipalities": "tsx scripts/generate-spanish-municipality-catalog.ts",
    "db:studio": "prisma studio",
    "db:up": "docker compose up -d mysql",
    "db:down": "docker compose down",
    "audit:security": "node scripts/dependency-security.mjs audit",
    "test:security:dependencies": "node scripts/dependency-security.mjs verify && node --test scripts/dependency-security.test.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.2",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.1",
    "date-fns": "^4.4.0",
    "fflate": "^0.8.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.24.0",
    "mariadb": "^3.5.4",
    "next": "16.4.0",
    "next-auth": "^4.24.15",
    "pdfjs-dist": "6.4.299",
    "prisma": "^7.10.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@hono/node-server": "^1.19.15",
    "cookie": "0.7.2",
    "next-auth": {
      "uuid": "11.1.1"
    },
    "postcss": "^8.5.30",
    "deepmerge-ts": "^8.0.2",
    "valibot": "^1.5.0",
    "mariadb": "$mariadb",
    "mysql2": "^3.24.6",
    "@auth/core": "^0.41.3"
  }
}
