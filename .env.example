DATABASE_URL="mysql://anella:anella_local@127.0.0.1:3307/anella"
# Solo para el simulacro local de restauración; debe poder crear y borrar una
# base efímera y el script rechaza staging/producción.
ANELLA_DRILL_ADMIN_DATABASE_URL="mysql://root:anella_root_local@127.0.0.1:3307/mysql"
ANELLA_ENV="development"
# En el dominio temporal usa ANELLA_ENV="staging" con todos los controles
# técnicos alojados descritos en docs/DEPLOYMENT.md. El seed queda prohibido.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-at-least-32-random-bytes"
IDEMPOTENCY_SECRET="replace-with-a-different-stable-32-byte-secret"
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="replace-with-32-random-bytes-in-base64"
APP_URL="http://localhost:3000"
DEPLOYMENT_VERSION="1.0.0"
APP_TIME_ZONE="Europe/Madrid"
SERVER_ACTION_ALLOWED_ORIGINS="localhost:3000"
TRUST_PROXY_HEADERS="false"
TRUSTED_PROXY_HOPS="1"
PRIVACY_CONTROLLER_NAME="Ayuntamiento responsable"
PRIVACY_CONTACT_EMAIL="privacidad@municipio.example"
PRIVACY_LEGAL_BASIS="Base jurídica aprobada por la entidad responsable"
PRIVACY_PROCESSOR_NAME="Proveedor de alojamiento contratado"
PRIVACY_RETENTION_DAYS="90"
LEGAL_ENTITY_NAME="Ayuntamiento responsable"
LEGAL_IDENTIFIER="Identificador fiscal real"
LEGAL_ADDRESS="Domicilio legal real"
LEGAL_CONTACT_EMAIL="legal@municipio.example"

SEED_ADMIN_EMAIL="admin@anella.local"
SEED_ADMIN_PASSWORD="AnellaLocal-2026!"
SEED_ADMIN_NAME="Coordinación municipal"
SEED_MUNICIPALITY_NAME="Municipio piloto"
SEED_ORGANIZATION_NAME="Protección Civil municipal"
SEED_DEMO_DATA="false"
SEED_RESET_ADMIN_PASSWORD="false"
SEED_BOOTSTRAP_ADMIN="false"
SEED_BOOTSTRAP_TICKET=""
SEED_BOOTSTRAP_OPERATOR=""

NASA_FIRMS_MAP_KEY=""
NASA_FIRMS_BOUNDS="-18.5,27.5,4.5,44.5"
NASA_FIRMS_SOURCE="VIIRS_SNPP_NRT"
# Ingesta automática privada. La URL KMZ oficial no necesita MAP_KEY.
FIRE_INGESTION_ENABLED="false"
FIRE_INGESTION_SECRET="replace-with-a-different-random-32-byte-secret"
NASA_FIRMS_AUTO_SOURCES="MODIS_NRT,VIIRS_NOAA21_NRT,VIIRS_NOAA20_NRT,VIIRS_SNPP_NRT"
FIRE_OFFICIAL_AUTO_SOURCES="BOMBERS_CATALUNYA,JCYL,INFOCA,MITECO_CCINIF"
FIRE_INGESTION_INTERVAL_MINUTES="5"
FIRE_DETECTION_MAX_AGE_HOURS="24"
FIRE_DETECTION_ASSIGNMENT_RADIUS_KM="50"

# Automatización segura: cada etapa se activa de forma independiente. Mantén
# estos valores cerrados hasta completar el gate de docs/NOTIFICATIONS.md.
DETECTION_CANDIDATE_AUTOMATION_ENABLED="false"
DETECTION_NOTIFICATION_OUTBOX_ENABLED="false"
NOTIFICATION_DELIVERY_ENABLED="false"
NOTIFICATION_DRILL_MODE="true"
DETECTION_CANDIDATE_RADIUS_METERS="5000"
DETECTION_CANDIDATE_WINDOW_MINUTES="120"
DETECTION_CANDIDATE_MIN_THERMAL_SIGNALS="3"
NOTIFICATION_OUTBOX_BATCH_SIZE="250"

# Honeypot accesible y sin proveedor externo. "disabled" se rechaza en
# producción; sustituirlo exige implementar y probar otro proveedor.
CONTRIBUTION_ANTI_AUTOMATION_MODE="honeypot"
